generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String?
  role      UserRole   @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cart      Cart?
  orders    Order[]
  wishlist  Wishlist[]
}

model Product {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  description   String?
  price         Int
  category      Category
  status        String?
  images        Json?
  gallery       Json?
  soundTests    Json?
  explodedView  String?
  technicalSpec String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  cartItems     CartItem[]
  inventory     Inventory?
  keyboardSpec  KeyboardSpec?
  keycapSpec    KeycapSpec?
  orderItems    OrderItem[]
  variants      ProductVariant[]
  switchSpec    SwitchSpec?
  wishlistItems Wishlist[]
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  sku        String?     @unique
  name       String
  extraPrice Int         @default(0)
  images     Json?
  specs      Json?
  cartItems  CartItem[]
  inventory  Inventory?
  orderItems OrderItem[]
  wishlistItems Wishlist[]
  product    Product     @relation(fields: [productId], references: [id])
}

model Inventory {
  id        String          @id @default(uuid())
  productId String?         @unique
  variantId String?         @unique
  stock     Int             @default(0)
  product   Product?        @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  cart      Cart            @relation(fields: [cartId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model Order {
  id                 String      @id @default(uuid())
  userId             String
  status             OrderStatus @default(PENDING)
  totalAmount        Int
  razorpayOrderId    String?
  razorpayPaymentId  String?
  createdAt          DateTime    @default(now())
  user               User        @relation(fields: [userId], references: [id])
  items              OrderItem[]
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  productId String
  variantId String?
  quantity  Int
  price     Int
  order     Order           @relation(fields: [orderId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

/// Keyboard-specific specs
model KeyboardSpec {
  id                  String              @id @default(uuid())
  productId           String              @unique
  layout              Layout
  mountingStyle       MountingStyle
  caseMaterial        CaseMaterial
  rgbOrientation      RGBOrientation
  hotSwap             Boolean             @default(false)
  switchCompatibility SwitchCompatibility
  connectivity        Json?
  plateMaterial       PlateMaterial?
  plateMountIncluded  Boolean             @default(false)
  stabilizerType      StabilizerType?
  weightGrams         Int?
  firmware            String?
  isoAnsi             String?
  notes               String?
  product             Product             @relation(fields: [productId], references: [id])
}

/// Switch-specific specs
model SwitchSpec {
  id            String     @id @default(uuid())
  productId     String     @unique
  switchType    SwitchType
  stemMaterial  String?
  topHousing    String?
  bottomHousing String?
  springWeight  Int?
  preTravel     Float?
  totalTravel   Float?
  lubed         Boolean?   @default(false)
  soundProfile  String?
  pins          String?
  product       Product    @relation(fields: [productId], references: [id])
}

/// Keycap-specific specs
model KeycapSpec {
  id         String         @id @default(uuid())
  productId  String         @unique
  profile    KeycapProfile
  material   KeycapMaterial
  thickness  Float?
  legends    String?
  rowSupport Boolean?
  notes      String?
  product    Product        @relation(fields: [productId], references: [id])
}

model Wishlist {
  id        String     @id @default(uuid())
  userId    String
  productId String?
  variantId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User        @relation(fields: [userId], references: [id])
  product   Product?    @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([userId, productId, variantId])
}

enum UserRole {
  USER
  ADMIN
}

enum Category {
  KEYBOARD
  SWITCH
  KEYCAP
  PLATE
  PCB
  STABILIZER
  ACCESSORY
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
  COMPLETED
}

enum Layout {
  ALICE
  ORTHOLINEAR
  P60
  P65
  P75
  TKL
  FULL
  OTHER
}

enum MountingStyle {
  TRAY
  GASKET
  TOP
  PLATE
  OTHER
}

enum CaseMaterial {
  ALUMINUM
  ABS
  PC
  ACRYLIC
  PBT
  OTHER
}

enum RGBOrientation {
  SOUTH
  NORTH
  NONE
}

enum SwitchCompatibility {
  THREE_PIN
  FIVE_PIN
  BOTH
}

enum Connectivity {
  WIRED
  WIRELESS
  BLUETOOTH
  TWO_POINT_FOUR_GHZ
}

enum SwitchType {
  LINEAR
  TACTILE
  CLICKY
  OTHER
}

enum PlateMaterial {
  ALUMINUM
  BRASS
  FR4
  PC
  STEEL
  OTHER
}

enum KeycapProfile {
  CHERRY
  OEM
  SA
  DSA
  XDA
  OTHER
}

enum KeycapMaterial {
  PBT
  ABS
  OTHER
}

enum StabilizerType {
  SCREW_IN
  CLIP_IN
  PCB_MOUNT
  OTHER
}
